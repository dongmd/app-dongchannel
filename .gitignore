# Repo-root .gitignore (defense-in-depth)
# App-specific ignores nằm trong app/.gitignore

# Sensitive local config
hermes-or-openclaw/config.txt
**/config.txt
**/.env
**/.env.local
**/.env.production.local
**/.env.development.local
*.pem
*.key

# Memory (per-user Claude context)
.claude/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# External plugin cache (installed via /vibe:init, not project source)
vibe-kit/

# Word source docs (kept as .md in docs/)
docs/*.docx

# Next.js build artifacts (also covered by app/.gitignore)
app/node_modules/
app/.next/
app/tsconfig.tsbuildinfo

# ---- Local secrets notebook ----
# PROJECT-SECRETS.local.md lives at the PARENT of both repos, outside any
# repository, so it cannot be committed by construction. These entries are the
# second layer: if the file is ever copied in here, git must refuse to see it.
PROJECT-SECRETS*
*.local.md
*.secrets.md
secrets.md
